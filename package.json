{
  "name": "llmtab",
  "version": "2.0.0",
  "description": "Local-first LLM token usage & cost tracker served in a browser tab.",
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "dashboard"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "llmtab": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "dashboard-dist"
  ],
  "scripts": {
    "dev": "concurrently -n cli,dashboard -c blue,green \"npm run build:cli -- --watch\" \"npm run dev --workspace dashboard\"",
    "build": "npm run build:cli && npm run build:dashboard",
    "build:cli": "tsc -p tsconfig.json && node -e \"const fs=require('node:fs');fs.mkdirSync('dist/cost/assets',{recursive:true});fs.copyFileSync('src/cost/assets/pricing-snapshot.json','dist/cost/assets/pricing-snapshot.json')\"",
    "build:dashboard": "npm run build --workspace dashboard",
    "app": "electron dist/shell/main.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck --workspace dashboard",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "commander": "^14.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "concurrently": "^10.0.5",
    "electron": "^44.0.0",
    "eslint": "^9.39.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
